{
    "name": "errogaht/wavespeed-ai-bundle",
    "description": "Symfony integration for WaveSpeedAI video generation, live model capabilities, pricing, uploads, predictions and verified webhooks.",
    "keywords": [
        "ai",
        "image-to-video",
        "symfony",
        "symfony-bundle",
        "text-to-video",
        "video-generation",
        "wavespeed"
    ],
    "homepage": "https://github.com/errogaht/wavespeed-ai-bundle",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [{"name": "Alex Teterin"}],
    "require": {
        "php": "^8.1",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "symfony/config": "^6.4 || ^7.4 || ^8.0",
        "symfony/console": "^6.4 || ^7.4 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.4 || ^8.0",
        "symfony/event-dispatcher": "^6.4 || ^7.4 || ^8.0",
        "symfony/framework-bundle": "^6.4 || ^7.4 || ^8.0",
        "symfony/http-client": "^6.4 || ^7.4 || ^8.0",
        "symfony/mime": "^6.4 || ^7.4 || ^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.85",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0",
        "symfony/phpunit-bridge": "^6.4 || ^7.4 || ^8.0",
        "symfony/yaml": "^6.4 || ^7.4 || ^8.0"
    },
    "suggest": {
        "errogaht/neuron-ai-bundle": "Expose model discovery, price estimation, and generation as tools for Neuron AI agents.",
        "symfony/messenger": "Process long predictions and verified webhook payloads asynchronously."
    },
    "autoload": {"psr-4": {"Errogaht\\WaveSpeedAiBundle\\": "src/"}},
    "autoload-dev": {"psr-4": {"Errogaht\\WaveSpeedAiBundle\\Tests\\": "tests/"}},
    "support": {
        "issues": "https://github.com/errogaht/wavespeed-ai-bundle/issues",
        "source": "https://github.com/errogaht/wavespeed-ai-bundle"
    },
    "config": {"sort-packages": true},
    "extra": {"branch-alias": {"dev-master": "0.1.x-dev"}},
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "check": ["@test", "@analyse", "@cs-check"]
    }
}
